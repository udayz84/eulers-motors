{
  "collectionName": "components_dealer_heroes",
  "info": {
    "displayName": "Dealer Locator Hero",
    "icon": "pinMap",
    "description": "Dealer locator hero with support badge, tabs, search, and map"
  },
  "options": {},
  "attributes": {
    "supportBadge": {
      "type": "string",
      "default": "Support"
    },
    "dealerTabLabel": {
      "type": "string",
      "default": "Dealer Locator"
    },
    "dealerTabTitle": {
      "type": "string",
      "default": "Find your nearest dealer."
    },
    "dealerTabSubtitle": {
      "type": "text",
      "default": "Every dealer brings the vehicle to you for a test drive."
    },
    "dealerSearchPlaceholder": {
      "type": "string",
      "default": "Search dealers by area"
    },
    "chargingTabLabel": {
      "type": "string",
      "default": "Charging Stations"
    },
    "chargingTabTitle": {
      "type": "string",
      "default": "Find a charging point."
    },
    "chargingTabSubtitle": {
      "type": "text",
      "default": "1,412 points across India, with live status on each one."
    },
    "chargingSearchPlaceholder": {
      "type": "string",
      "default": "Search charging points by area"
    },
    "serviceTabLabel": {
      "type": "string",
      "default": "Service Centers"
    },
    "serviceTabTitle": {
      "type": "string",
      "default": "Find a service center."
    },
    "serviceTabSubtitle": {
      "type": "text",
      "default": "Authorized Euler service centers with genuine parts and certified experts."
    },
    "serviceSearchPlaceholder": {
      "type": "string",
      "default": "Search service centers by area"
    },
    "cities": {
      "type": "string",
      "default": "Hyderabad, Delhi NCR, Bengaluru, Mumbai, Ahmedabad, Kolkata"
    },
    "defaultCity": {
      "type": "string",
      "default": "Mumbai"
    },
    "locationButtonLabel": {
      "type": "string",
      "default": "Use my current location"
    },
    "dealerResultsLabel": {
      "type": "string",
      "default": "Dealers Found"
    },
    "chargingResultsLabel": {
      "type": "string",
      "default": "Charging Points"
    },
    "serviceResultsLabel": {
      "type": "string",
      "default": "Service Centers Found"
    },
    "directionsButtonLabel": {
      "type": "string",
      "default": "Get Directions"
    },
    "distanceUnit": {
      "type": "string",
      "default": "km"
    },
    "emptyStateText": {
      "type": "string",
      "default": "No matching locations found."
    },
    "mapImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "dealers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::dealer.dealer"
    },
    "chargingStations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::charging-station.charging-station"
    },
    "serviceCenters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-center.service-center"
    }
  }
}
