{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Euler Motors vehicle models and showcase cards"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "tabLabel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "specsRange": {
      "type": "string",
      "required": true
    },
    "specsCapacity": {
      "type": "string",
      "required": true
    },
    "specsChargeTime": {
      "type": "string",
      "required": true
    },
    "productUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "text"
    },
    "specs": {
      "type": "component",
      "repeatable": false,
      "component": "product.specs"
    },
    "variantsCompare": {
      "type": "component",
      "repeatable": false,
      "component": "product.variants-compare"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "product.hero"
    },
    "overview": {
      "type": "component",
      "repeatable": false,
      "component": "product.overview"
    },
    "loanCalculator": {
      "type": "component",
      "repeatable": false,
      "component": "product.loan-calculator"
    },
    "otherVehicles": {
      "type": "component",
      "repeatable": false,
      "component": "product.other-vehicles"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review"
    }
  }
}
