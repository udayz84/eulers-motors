{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Euler Motors vehicle models and full page specifications"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "tabLabel": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "specsRange": {
      "type": "string",
      "required": true
    },
    "specsCapacity": {
      "type": "string",
      "required": true
    },
    "specsChargeTime": {
      "type": "string",
      "required": true
    },
    "productUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "product.hero"
    },
    "specs": {
      "type": "component",
      "repeatable": false,
      "component": "product.specs"
    },
    "savingsCalculator": {
      "type": "component",
      "repeatable": false,
      "component": "shared.savings-calculator"
    },
    "variantsCompare": {
      "type": "component",
      "repeatable": false,
      "component": "product.variants-compare"
    },
    "overview": {
      "type": "component",
      "repeatable": false,
      "component": "product.overview"
    },
    "loanCalculator": {
      "type": "component",
      "repeatable": false,
      "component": "product.loan-calculator"
    },
    "reviewsSection": {
      "type": "component",
      "repeatable": false,
      "component": "home.reviews-section"
    },
    "otherVehiclesSection": {
      "type": "component",
      "repeatable": false,
      "component": "product.other-vehicles"
    },
    "contactSection": {
      "type": "component",
      "repeatable": false,
      "component": "home.contact-section"
    }
  }
}
