{
  "kind": "collectionType",
  "collectionName": "charging_stations",
  "info": {
    "singularName": "charging-station",
    "pluralName": "charging-stations",
    "displayName": "Charging Station",
    "description": "Euler Motors EV charging network and hubs"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "address": {
      "type": "text",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "hours": {
      "type": "string",
      "default": "Open 24 hours"
    },
    "distance": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "default": "1800 000 0000"
    },
    "badges": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
