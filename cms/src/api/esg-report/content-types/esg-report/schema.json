{
  "kind": "collectionType",
  "collectionName": "esg_reports",
  "info": {
    "singularName": "esg-report",
    "pluralName": "esg-reports",
    "displayName": "ESG Report",
    "description": "Downloadable ESG reports and corporate disclosure documents"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "fileSize": {
      "type": "string",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "externalUrl": {
      "type": "string"
    },
    "iconVariant": {
      "type": "enumeration",
      "enum": ["default", "highlight"],
      "default": "default"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}

