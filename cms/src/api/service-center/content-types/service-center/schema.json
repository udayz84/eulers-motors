{
  "kind": "collectionType",
  "collectionName": "service_centers",
  "info": {
    "singularName": "service-center",
    "pluralName": "service-centers",
    "displayName": "Service Center",
    "description": "Authorized Euler Motors service centers and workshops"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "address": {
      "type": "text",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "hours": {
      "type": "string",
      "default": "Open until 8 pm"
    },
    "distance": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "default": "1800 000 0000"
    },
    "badges": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
