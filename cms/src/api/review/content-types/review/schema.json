{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Customer stories and reviews"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "customerName": {
      "type": "string",
      "required": true
    },
    "roleOrCompany": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "quote": {
      "type": "text"
    },
    "storyImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "overlayImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "avatarImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos", "files"]
    },
    "videoDuration": {
      "type": "string"
    },
    "savingsMonthly": {
      "type": "string"
    },
    "rating": {
      "type": "decimal"
    },
    "videoUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
